    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0-preview.4.26202.104" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0-preview.4.26202.104" />
